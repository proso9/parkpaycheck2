# Python 编译缓存
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
dist/
build/

# 虚拟环境
venv/
.venv/
env/
ENV/

# IDE 及操作系统
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo

# 项目数据目录（日志文件及输出结果）
data/input/*.log
data/input/*.txt
data/output/
logs/*.log
logs/*.out

# 异常车辆检测脚本的输出结果
output/

# 测试脚本
tests/

# 保留空目录结构（使文件夹能被提交到仓库）
!data/output/.gitkeep
!logs/.gitkeep

# 本地配置文件（含绝对路径或密钥）
config/settings.yaml
config/*.local.yaml
*.secret.yaml
.env

# 运行时临时文件
*.lock
*.pid
.pytest_cache/
.coverage

# 开发文档
document/
docs/
# ZCode 工具自动生成的排除规则（内容派生自本文件，可随时再生成）
.zcodeignore
