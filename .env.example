# parkcheck 本地配置模板：复制为 .env 并填写后生效（.env 已加入 .gitignore，不入仓库）
# 优先级：显式命令行参数 > 系统环境变量 > 本文件 > config.py 默认值
# 语法：KEY=VALUE，支持 # 注释行；值含 # 或空格时用引号包裹；支持 "export " 前缀

# 是否默认开启上传（1/true/yes/on 均可；留空视为关闭，仍可在 CLI/GUI 开启）
UPLOAD_ENABLED=

# Cloudflare Account ID
CF_ACCOUNT_ID=

# D1 Database UUID
CF_DATABASE_ID=

# Cloudflare API Token（需 D1:Edit 权限；仅存本地，绝不随 GUI「导出配置」JSON 导出）
CF_API_TOKEN=

# 单次上传请求最多合并的记录数
DB_BATCH_SIZE=50
